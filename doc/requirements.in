# Specific/minimum versions of documentation build dependencies
#
# Versions are set according to, in order of preference:
# 1. Set according to a dependabot security alert.
# 2. The minimum version pyproject.toml, if any.
# 3. A recent version.
#
# View the line blame for details.
#
# After updating this file, run:
#   uv pip compile requirements.in -o requirements.txt

# Direct dependencies
#
# This is the same list as [doc] in pyproject.toml.

GitPython >= 3.2.1
genno >= 1.26
numpydoc
sphinx-rtd-theme >= 3.1.0
sphinx >= 9.2
sphinxcontrib-bibtex >= 2.6.5

# Indirect dependencies, per security alerts

idna >= 3.15
pygments >= 2.20.0
requests >= 2.33.0
urllib3 >= 2.8.0
